APP_NAME=Laravel
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Haupt-Laravel-DB (users, cache, sessions) — eigene, von .env getrennte
# Test-Datenbank, damit Tests nie echte User-Accounts beruehren.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ibkr_laravel_test
DB_USERNAME=root
DB_PASSWORD=

# Trading-DBs — dieselbe lokale MySQL-Instanz wie in .env, aber immer mit
# TABLE_PREFIX=phpunit_ (siehe tests/Concerns/UsesTradingTestConnection.php).
# Nutzt die bereits vorhandene ibkr_test-Datenbank (config/database.php),
# NIE die echten karola_/mike_-Tabellen darin.
TRADING_DB_HOST=127.0.0.1
TRADING_DB_PORT=3306
TRADING_DB_USERNAME=root
TRADING_DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
